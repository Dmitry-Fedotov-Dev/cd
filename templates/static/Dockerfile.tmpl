# cd: type static — build with npm when there is a package.json, serve the files with Caddy.
{{- if .HasPackage}}
FROM node:{{.Node}} AS build
WORKDIR /app
ENV npm_config_update_notifier=false npm_config_fund=false npm_config_audit=false \
    NODE_OPTIONS=--max-old-space-size=512
COPY package*.json ./
RUN if [ -f package-lock.json ]; then npm ci --include=dev; else npm install --include=dev; fi
COPY . .
RUN npm run build
{{- end}}

FROM caddy:2-alpine
# the image's caddy carries cap_net_bind_service, which no-new-privileges forbids; a plain copy
# has no file capabilities and port 3000 needs none
RUN cp /usr/bin/caddy /usr/local/bin/caddy
ENV XDG_CONFIG_HOME=/tmp/config XDG_DATA_HOME=/tmp/data
{{- if .HasPackage}}
COPY --from=build /app/{{.StaticDir}} /srv
{{- else}}
COPY . /srv
{{- end}}
EXPOSE 3000
CMD ["/usr/local/bin/caddy", "file-server", "--root", "/srv", "--listen", ":3000"]
